    (:reset-pose (&optional (limbs '(:torso :rarm :larm :head)))
      "Predefined pose named reset-pose."
      (unless (listp limbs) (setq limbs (list limbs)))
      (dolist (limb limbs)
        (case limb
          (:torso (send self limb :angle-vector (float-vector 0.000000)))
          (:rarm (send self limb :angle-vector (float-vector -0.600000 0.000000 -100.000000 15.200000 9.400000 3.200000)))
          (:larm (send self limb :angle-vector (float-vector 0.600000 0.000000 -100.000000 -15.200000 9.400000 -3.200000)))
          (:head (send self limb :angle-vector (float-vector 0.000000 0.000000)))
          (t (format t "Unknown limb is passed: ~a~%" limb))))
      (send self :angle-vector))
