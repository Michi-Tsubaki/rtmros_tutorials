(defun nextage-collision-check ()
  (let ((ret (send *nextage* :self-collision-check)))
    (when ret
      (setq ret (remove-if #'(lambda (l)
                               (or (and (eq (car l) (send *nextage* :link "CHEST_JOINT0_Link"))
                                        (eq (cdr l) (send *nextage* :link "HEAD_JOINT1_Link")))
                                   (and (eq (cdr l) (send *nextage* :link "CHEST_JOINT0_Link"))
                                        (eq (car l) (send *nextage* :link "HEAD_JOINT1_Link")))
                                   (and (eq (car l) (send *nextage* :link "LARM_JOINT4_Link"))
                                        (eq (cdr l) (send *nextage* :link "LARM_JOINT5_Link")))
                                   (and (eq (cdr l) (send *nextage* :link "LARM_JOINT4_Link"))
                                        (eq (car l) (send *nextage* :link "LARM_JOINT5_Link")))
                                   (and (eq (car l) (send *nextage* :link "RARM_JOINT4_Link"))
                                        (eq (cdr l) (send *nextage* :link "RARM_JOINT5_Link")))
                                   (and (eq (cdr l) (send *nextage* :link "RARM_JOINT4_Link"))
                                        (eq (car l) (send *nextage* :link "RARM_JOINT5_Link")))))
                           ret)))
    ret))
