<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>nextage_tutorials</name>
  <version>0.1.0</version>
  <description>ROS 2 tutorials and utilities for the NEXTAGE OPEN robot.</description>

  <maintainer email="tsubaki@jsk.t.u-tokyo.ac.jp">Michitoshi Tsubaki</maintainer>
  <author email="k-okada@jsk.t.u-tokyo.ac.jp">Kei Okada</author>
  <license>BSD</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <exec_depend>ament_index_python</exec_depend>
  <depend>builtin_interfaces</depend>
  <depend>control_msgs</depend>
  <exec_depend>dynamixel_detachable_hand</exec_depend>
  <depend>geometry_msgs</depend>
  <exec_depend>image_view</exec_depend>
  <exec_depend>interactive_markers</exec_depend>
  <exec_depend>leptrino_force_torque</exec_depend>
  <depend>nextage_description</depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>realsense2_camera</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>ros1_bridge</exec_depend>
  <depend>roseus</depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>tf2_ros_py</exec_depend>
  <depend>sensor_msgs</depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>touch_msgs</exec_depend>
  <depend>trajectory_msgs</depend>
  <exec_depend>usb_cam</exec_depend>
  <!--<exec_depend>interactive_markers</exec_depend>-->
  <!--<exec_depend>visualization_msgs</exec_depend>-->
  <exec_depend>xacro</exec_depend>
  <test_depend>ament_cmake_test</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
