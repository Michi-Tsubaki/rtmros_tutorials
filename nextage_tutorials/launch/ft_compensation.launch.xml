<?xml version="1.0"?>
<launch>
  <arg name="left_calibration_file" default="$(env HOME)/.ros/nextage/larm_ft_payload.yaml" />
  <arg name="right_calibration_file" default="$(env HOME)/.ros/nextage/rarm_ft_payload.yaml" />
  <!-- Detect once and validate feedback before starting nodes. -->
  <let name="detected" value="$(command '&quot;$(find-pkg-prefix nextage_tutorials)/lib/nextage_tutorials/detect_admittance_sensors.py&quot; ft_compensation --left-calibration-file &quot;$(var left_calibration_file)&quot; --right-calibration-file &quot;$(var right_calibration_file)&quot;' 'warn')" />
  <let name="use_left" value="$(eval &quot;'larm' in $(var detected)['arms']&quot;)" />
  <let name="use_right" value="$(eval &quot;'rarm' in $(var detected)['arms']&quot;)" />
  <node if="$(var use_left)" pkg="nextage_tutorials" exec="ft_payload_identification.py" name="larm_ft_compensation" output="screen">
    <param name="arm" value="larm" />
    <param name="input_topic" value="/left_ft/force_torque" />
    <param name="output_topic" value="/left_ft/force_torque_compensated" />
    <param name="sensor_frame" value="LARM_FTSENSOR_SENSOR_Link" />
    <param name="output_file" value="$(var left_calibration_file)" />
    <param name="load_file" value="$(var left_calibration_file)" />
  </node>
  <node if="$(var use_right)" pkg="nextage_tutorials" exec="ft_payload_identification.py" name="rarm_ft_compensation" output="screen">
    <param name="arm" value="rarm" />
    <param name="input_topic" value="/right_ft/force_torque" />
    <param name="output_topic" value="/right_ft/force_torque_compensated" />
    <param name="sensor_frame" value="RARM_FTSENSOR_SENSOR_Link" />
    <param name="output_file" value="$(var right_calibration_file)" />
    <param name="load_file" value="$(var right_calibration_file)" />
  </node>
</launch>
