<?xml version="1.0"?>
<launch>
  <arg name="right_comport" default="/dev/right_ft_sensor"/>
  <arg name="left_comport" default="/dev/left_ft_sensor"/>
  <arg name="right_namespace" default="right_ft"/>
  <arg name="left_namespace" default="left_ft"/>
  <arg name="right_frame_id" default="right_ft_sensor"/>
  <arg name="left_frame_id" default="left_ft_sensor"/>

  <include file="$(find-pkg-share leptrino_force_torque)/launch/leptrino.launch.xml">
    <arg name="comport" value="$(var right_comport)"/>
    <arg name="namespace" value="$(var right_namespace)"/>
    <arg name="node_name" value="leptrino_force_torque"/>
    <arg name="frame_id" value="$(var right_frame_id)"/>
  </include>

  <include file="$(find-pkg-share leptrino_force_torque)/launch/leptrino.launch.xml">
    <arg name="comport" value="$(var left_comport)"/>
    <arg name="namespace" value="$(var left_namespace)"/>
    <arg name="node_name" value="leptrino_force_torque"/>
    <arg name="frame_id" value="$(var left_frame_id)"/>
  </include>
</launch>
