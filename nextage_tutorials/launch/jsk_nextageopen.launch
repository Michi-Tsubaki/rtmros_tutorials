<launch>
  <arg name="node_start_delay" default="2.0" />
  <param name="robot_description" textfile="$(find nextage_tutorials)/urdf/JSKNextageOpen.urdf" />

  <node name="nextage_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher">
  </node>

  <node name="joint_state_publisher" pkg="joint_state_publisher" type="joint_state_publisher">
    <param name="use_gui" value="false" />
  </node>

  <include file="$(find dynamixel_detachable_hand)/launch/dual_hand.launch" >
  </include>
  
  <!--<include file="$(find nextage_tutorials)/launch/elp_camera.launch" >
  </include> -->
  
  <include file="$(find nextage_tutorials)/launch/right_ft_sensor.launch" >
  </include>

  <!--<include file="$(find nextage_tutorials)/launch/ft_sensor_calib.launch" >
  </include> -->
  
  <include file="$(find nextage_tutorials)/launch/l515_head.launch" >
  </include>

  <!--<include file="$(find nextage_tutorials)/launch/dual_touch.launch" >
  </include> -->

</launch>
