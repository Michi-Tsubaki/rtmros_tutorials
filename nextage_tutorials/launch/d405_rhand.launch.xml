<?xml version="1.0"?>
<launch>
  <arg name="camera_namespace" default="rhand_camera"/>
  <arg name="camera_name" default="rhand_camera"/>
  <arg name="serial_no" default="230322275554"/>
  <arg name="usb_port_id" default=""/>
  <arg name="json_file_path" default=""/>
  <arg name="initial_reset" default="false"/>
  <arg name="enable_pointcloud" default="true"/>
  <arg name="enable_color" default="true"/>
  <arg name="enable_depth" default="true"/>
  <arg name="enable_infra" default="false"/>
  <arg name="enable_infra1" default="false"/>
  <arg name="enable_infra2" default="false"/>
  <arg name="depth_profile" default="0,0,0"/>
  <arg name="color_profile" default="0,0,0"/>
  <arg name="enable_sync" default="true"/>
  <arg name="align_depth" default="true"/>
  <arg name="publish_tf" default="true"/>
  <arg name="tf_publish_rate" default="0"/>
  <arg name="base_frame_id" default="RARM_CAMERA_Link"/>
  <arg name="tf_prefix" default=""/>
  <arg name="log_level" default="info"/>

  <include file="$(find-pkg-share nextage_tutorials)/launch/raw/d405_camera.launch.xml">
    <arg name="camera_namespace" value="$(var camera_namespace)"/>
    <arg name="camera_name" value="$(var camera_name)"/>
    <arg name="serial_no" value="$(var serial_no)"/>
    <arg name="usb_port_id" value="$(var usb_port_id)"/>
    <arg name="json_file_path" value="$(var json_file_path)"/>
    <arg name="initial_reset" value="$(var initial_reset)"/>
    <arg name="enable_pointcloud" value="$(var enable_pointcloud)"/>
    <arg name="enable_color" value="$(var enable_color)"/>
    <arg name="enable_depth" value="$(var enable_depth)"/>
    <arg name="enable_infra" value="$(var enable_infra)"/>
    <arg name="enable_infra1" value="$(var enable_infra1)"/>
    <arg name="enable_infra2" value="$(var enable_infra2)"/>
    <arg name="depth_profile" value="$(var depth_profile)"/>
    <arg name="color_profile" value="$(var color_profile)"/>
    <arg name="enable_sync" value="$(var enable_sync)"/>
    <arg name="align_depth" value="$(var align_depth)"/>
    <arg name="publish_tf" value="$(var publish_tf)"/>
    <arg name="tf_publish_rate" value="$(var tf_publish_rate)"/>
    <arg name="base_frame_id" value="$(var base_frame_id)"/>
    <arg name="tf_prefix" value="$(var tf_prefix)"/>
    <arg name="log_level" value="$(var log_level)"/>
  </include>
</launch>
