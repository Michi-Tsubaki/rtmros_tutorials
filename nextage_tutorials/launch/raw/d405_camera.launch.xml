<?xml version="1.0"?>
<launch>
  <arg name="camera_namespace" default="rhand_camera"/>
  <arg name="camera_name" default="rhand_camera"/>
  <arg name="serial_no" default=""/>
  <arg name="usb_port_id" default=""/>
  <arg name="json_file_path" default=""/>
  <arg name="initial_reset" default="false"/>
  <arg name="enable_pointcloud" default="true"/>
  <arg name="pointcloud_stream_filter" default="2"/>
  <arg name="pointcloud_stream_index_filter" default="0"/>
  <arg name="allow_no_texture_points" default="false"/>
  <arg name="ordered_pc" default="false"/>
  <arg name="enable_color" default="true"/>
  <arg name="enable_depth" default="true"/>
  <arg name="enable_infra" default="false"/>
  <arg name="enable_infra1" default="false"/>
  <arg name="enable_infra2" default="false"/>
  <arg name="depth_profile" default="0,0,0"/>
  <arg name="depth_format" default="Z16"/>
  <arg name="color_profile" default="0,0,0"/>
  <arg name="color_format" default="RGB8"/>
  <arg name="enable_gyro" default="false"/>
  <arg name="enable_accel" default="false"/>
  <arg name="enable_sync" default="true"/>
  <arg name="align_depth" default="true"/>
  <arg name="publish_tf" default="true"/>
  <arg name="tf_publish_rate" default="0"/>
  <arg name="base_frame_id" default="RARM_CAMERA_Link"/>
  <arg name="tf_prefix" default=""/>
  <arg name="clip_distance" default="-2."/>
  <arg name="reconnect_timeout" default="6."/>
  <arg name="wait_for_device_timeout" default="-1."/>
  <arg name="depth_module_enable_auto_exposure" default="true"/>
  <arg name="depth_module_exposure" default="8500"/>
  <arg name="depth_module_gain" default="16"/>
  <arg name="depth_module_exposure_1" default="7500"/>
  <arg name="depth_module_gain_1" default="16"/>
  <arg name="depth_module_exposure_2" default="1"/>
  <arg name="depth_module_gain_2" default="16"/>
  <arg name="hdr_merge" default="false"/>
  <arg name="log_level" default="info"/>

  <node pkg="realsense2_camera" exec="realsense2_camera_node"
        namespace="$(var camera_namespace)" name="$(var camera_name)"
        output="screen" args="--ros-args --log-level $(var log_level)">
    <param name="camera_name" type="str" value="$(var camera_name)"/>
    <param name="serial_no" type="str" value="$(var serial_no)"/>
    <param name="usb_port_id" type="str" value="$(var usb_port_id)"/>
    <param name="device_type" type="str" value="d405"/>
    <param name="json_file_path" type="str" value="$(var json_file_path)"/>
    <param name="initial_reset" type="bool" value="$(var initial_reset)"/>
    <param name="enable_color" type="bool" value="$(var enable_color)"/>
    <param name="enable_depth" type="bool" value="$(var enable_depth)"/>
    <param name="enable_infra" type="bool" value="$(var enable_infra)"/>
    <param name="enable_infra1" type="bool" value="$(var enable_infra1)"/>
    <param name="enable_infra2" type="bool" value="$(var enable_infra2)"/>
    <param name="depth_module.depth_profile" type="str" value="$(var depth_profile)"/>
    <param name="depth_module.depth_format" type="str" value="$(var depth_format)"/>
    <param name="depth_module.color_profile" type="str" value="$(var color_profile)"/>
    <param name="depth_module.color_format" type="str" value="$(var color_format)"/>
    <param name="depth_module.enable_auto_exposure" type="bool" value="$(var depth_module_enable_auto_exposure)"/>
    <param name="depth_module.exposure" type="int" value="$(var depth_module_exposure)"/>
    <param name="depth_module.gain" type="int" value="$(var depth_module_gain)"/>
    <param name="depth_module.exposure.1" type="int" value="$(var depth_module_exposure_1)"/>
    <param name="depth_module.gain.1" type="int" value="$(var depth_module_gain_1)"/>
    <param name="depth_module.exposure.2" type="int" value="$(var depth_module_exposure_2)"/>
    <param name="depth_module.gain.2" type="int" value="$(var depth_module_gain_2)"/>
    <param name="enable_gyro" type="bool" value="$(var enable_gyro)"/>
    <param name="enable_accel" type="bool" value="$(var enable_accel)"/>
    <param name="enable_sync" type="bool" value="$(var enable_sync)"/>
    <param name="pointcloud.enable" type="bool" value="$(var enable_pointcloud)"/>
    <param name="pointcloud.stream_filter" type="int" value="$(var pointcloud_stream_filter)"/>
    <param name="pointcloud.stream_index_filter" type="int" value="$(var pointcloud_stream_index_filter)"/>
    <param name="pointcloud.allow_no_texture_points" type="bool" value="$(var allow_no_texture_points)"/>
    <param name="pointcloud.ordered_pc" type="bool" value="$(var ordered_pc)"/>
    <param name="align_depth.enable" type="bool" value="$(var align_depth)"/>
    <param name="hdr_merge.enable" type="bool" value="$(var hdr_merge)"/>
    <param name="clip_distance" type="float" value="$(var clip_distance)"/>
    <param name="reconnect_timeout" type="float" value="$(var reconnect_timeout)"/>
    <param name="wait_for_device_timeout" type="float" value="$(var wait_for_device_timeout)"/>
    <param name="publish_tf" type="bool" value="$(var publish_tf)"/>
    <param name="tf_publish_rate" type="float" value="$(var tf_publish_rate)"/>
    <param name="base_frame_id" type="str" value="$(var base_frame_id)"/>
    <param name="tf_prefix" type="str" value="$(var tf_prefix)"/>
  </node>

  <!-- realsense-ros-l515 prefixes base_frame_id with camera_name internally. -->
  <node pkg="tf2_ros" exec="static_transform_publisher"
        name="$(var camera_name)_base_frame_bridge"
        args="--frame-id $(var base_frame_id) --child-frame-id $(var camera_name)_$(var base_frame_id)"/>
</launch>
