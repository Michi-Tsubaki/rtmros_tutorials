<?xml version="1.0"?>
<launch>
  <arg name="camera_namespace" default="top_camera"/>
  <arg name="camera_name" default="top_camera"/>
  <arg name="serial_no" default="f0233276"/>
  <arg name="usb_port_id" default=""/>
  <arg name="initial_reset" default="true"/>
  <arg name="enable_pointcloud" default="true"/>
  <arg name="pointcloud_stream_filter" default="2"/>
  <arg name="pointcloud_stream_index_filter" default="0"/>
  <arg name="ordered_pc" default="true"/>
  <arg name="enable_infra" default="false"/>
  <arg name="enable_confidence" default="false"/>
  <arg name="enable_gyro" default="false"/>
  <arg name="enable_accel" default="false"/>
  <arg name="align_depth" default="true"/>
  <arg name="publish_tf" default="true"/>
  <arg name="tf_publish_rate" default="0"/>
  <arg name="base_frame_id" default="link"/>
  <arg name="log_level" default="info"/>

  <node pkg="realsense2_camera" exec="realsense2_camera_node"
        namespace="$(var camera_namespace)" name="$(var camera_name)"
        output="screen" args="--ros-args --log-level $(var log_level)">
    <param name="camera_name" type="str" value="$(var camera_name)"/>
    <param name="serial_no" type="str" value="$(var serial_no)"/>
    <param name="usb_port_id" type="str" value="$(var usb_port_id)"/>
    <param name="device_type" type="str" value="l515"/>
    <param name="initial_reset" type="bool" value="$(var initial_reset)"/>
    <param name="enable_color" type="bool" value="true"/>
    <param name="enable_depth" type="bool" value="true"/>
    <param name="enable_infra" type="bool" value="$(var enable_infra)"/>
    <param name="enable_infra1" type="bool" value="false"/>
    <param name="enable_infra2" type="bool" value="false"/>
    <param name="depth_module.profile" type="str" value="640x480x30"/>
    <param name="rgb_camera.profile" type="str" value="640x480x30"/>
    <param name="enable_gyro" type="bool" value="$(var enable_gyro)"/>
    <param name="enable_accel" type="bool" value="$(var enable_accel)"/>
    <param name="enable_sync" type="bool" value="true"/>
    <param name="enable_confidence" type="bool" value="$(var enable_confidence)"/>
    <param name="pointcloud.enable" type="bool" value="$(var enable_pointcloud)"/>
    <param name="pointcloud.stream_filter" type="int" value="$(var pointcloud_stream_filter)"/>
    <param name="pointcloud.stream_index_filter" type="int" value="$(var pointcloud_stream_index_filter)"/>
    <param name="pointcloud.ordered_pc" type="bool" value="$(var ordered_pc)"/>
    <param name="align_depth.enable" type="bool" value="$(var align_depth)"/>
    <param name="publish_tf" type="bool" value="$(var publish_tf)"/>
    <param name="tf_publish_rate" type="float" value="$(var tf_publish_rate)"/>
    <param name="base_frame_id" type="str" value="$(var base_frame_id)"/>
  </node>
</launch>
