<?xml version="1.0"?>
<launch>
  <arg name="image_view" default="false"/>
  <arg name="log_level" default="info"/>

  <arg name="video_device" default="/dev/video15"/>
  <arg name="camera_name" default="lhand"/>
  <arg name="frame_id" default="lhand"/>
  <arg name="image_width" default="640"/>
  <arg name="image_height" default="480"/>
  <arg name="framerate" default="30.0"/>

  <node respawn="true" respawn_delay="3.0"
    pkg="usb_cam"
    exec="usb_cam_node_exe"
    name="lhand_camera"
    output="screen"
    args="--ros-args --log-level $(var log_level)">
    <param name="video_device" type="str" value="$(var video_device)"/>
    <param name="io_method" type="str" value="mmap"/>
    <param name="pixel_format" type="str" value="mjpeg2rgb"/>
    <param name="av_device_format" type="str" value="YUV422P"/>
    <param name="camera_name" type="str" value="$(var camera_name)"/>
    <param name="frame_id" type="str" value="$(var frame_id)"/>
    <param name="camera_info_url" type="str" value=""/>
    <param name="image_width" type="int" value="$(var image_width)"/>
    <param name="image_height" type="int" value="$(var image_height)"/>
    <param name="framerate" type="float" value="$(var framerate)"/>

    <param name="autofocus" type="bool" value="true"/>
    <param name="autoexposure" type="bool" value="false"/>
    <param name="auto_white_balance" type="bool" value="false"/>
    <param name="brightness" type="int" value="200"/>
    <param name="contrast" type="int" value="-1"/>
    <param name="saturation" type="int" value="-1"/>
    <param name="sharpness" type="int" value="-1"/>
    <param name="gain" type="int" value="-1"/>

    <remap from="image_raw" to="/lhand_camera/image_raw"/>
    <remap from="image_raw/compressed" to="/lhand_camera/image_raw/compressed"/>
    <remap from="camera_info" to="/lhand_camera/camera_info"/>
  </node>

  <node
    if="$(var image_view)"
    pkg="image_view"
    exec="image_view"
    name="image_view"
    respawn="false"
    output="screen">
    <remap from="image" to="/lhand_camera/image_raw"/>
    <param name="autosize" type="bool" value="false"/>
  </node>
</launch>
