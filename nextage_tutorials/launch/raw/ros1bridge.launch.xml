<?xml version="1.0"?>
<launch>
  <arg name="log_level" default="info"/>

  <!--
    dynamic_bridge auto-discovers both the required topics and the controllers'
    actions. ROS 2 exposes the latter as actions (for example,
    control_msgs/action/FollowJointTrajectory), while ROS 1 exposes the same
    interface via actionlib (control_msgs/FollowJointTrajectory).

    Do not run parameter_bridge for the same topics at the same time. Two
    bidirectional bridges form a ROS 1 <-> ROS 2 feedback loop: joint_states is
    amplified and repeated fullbody_controller/command messages continually
    restart hrpsys trajectories at their first point.

    Do not add the bridge-all-topics option here. That forces subscriptions to camera
    image_transport topics and can trigger compressed/depthcompressed
    publishers in realsense2_camera.
  -->
  <node
    pkg="ros1_bridge"
    exec="dynamic_bridge"
    name="nextage_dynamic_bridge"
    output="screen"
    args="__name:=nextage_dynamic_bridge --ros-args --log-level $(var log_level)"/>

</launch>
