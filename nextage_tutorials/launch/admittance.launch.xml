<?xml version="1.0"?>
<launch>
  <arg name="controller_manager_timeout" default="30" />
  <arg name="inactive" default="true">
    <choice value="true" />
    <choice value="false" />
  </arg>
  <arg name="params_file" default="$(find-pkg-share nextage_tutorials)/config/nextage_admittance.yaml" />
  <arg name="controller_manager" default="/controller_manager" />
  <arg name="gravity_params_file" default="" />
  <!-- Detect once and validate feedback before starting nodes. -->
  <let name="detected" value="$(command '&quot;$(find-pkg-prefix nextage_tutorials)/lib/nextage_tutorials/detect_admittance_sensors.py&quot; admittance' 'warn')" />
  <let name="activation_args" value="$(eval &quot;'--inactive' if '$(var inactive)' == 'true' else '--activate-as-group'&quot;)" />
  <group if="$(eval &quot;$(var detected)['arms'] == ['larm']&quot;)">
    <node if="$(eval &quot;'$(var gravity_params_file)' != ''&quot;)" pkg="controller_manager" exec="spawner" output="screen" args="larm_admittance_controller --param-file $(var params_file) --param-file $(var gravity_params_file) --controller-manager $(var controller_manager) --controller-manager-timeout $(var controller_manager_timeout) $(var activation_args)" />
    <node unless="$(eval &quot;'$(var gravity_params_file)' != ''&quot;)" pkg="controller_manager" exec="spawner" output="screen" args="larm_admittance_controller --param-file $(var params_file) --controller-manager $(var controller_manager) --controller-manager-timeout $(var controller_manager_timeout) $(var activation_args)" />
  </group>
  <group if="$(eval &quot;$(var detected)['arms'] == ['rarm']&quot;)">
    <node if="$(eval &quot;'$(var gravity_params_file)' != ''&quot;)" pkg="controller_manager" exec="spawner" output="screen" args="rarm_admittance_controller --param-file $(var params_file) --param-file $(var gravity_params_file) --controller-manager $(var controller_manager) --controller-manager-timeout $(var controller_manager_timeout) $(var activation_args)" />
    <node unless="$(eval &quot;'$(var gravity_params_file)' != ''&quot;)" pkg="controller_manager" exec="spawner" output="screen" args="rarm_admittance_controller --param-file $(var params_file) --controller-manager $(var controller_manager) --controller-manager-timeout $(var controller_manager_timeout) $(var activation_args)" />
  </group>
  <group if="$(eval &quot;$(var detected)['arms'] == ['larm', 'rarm']&quot;)">
    <node if="$(eval &quot;'$(var gravity_params_file)' != ''&quot;)" pkg="controller_manager" exec="spawner" output="screen" args="larm_admittance_controller rarm_admittance_controller --param-file $(var params_file) --param-file $(var gravity_params_file) --controller-manager $(var controller_manager) --controller-manager-timeout $(var controller_manager_timeout) $(var activation_args)" />
    <node unless="$(eval &quot;'$(var gravity_params_file)' != ''&quot;)" pkg="controller_manager" exec="spawner" output="screen" args="larm_admittance_controller rarm_admittance_controller --param-file $(var params_file) --controller-manager $(var controller_manager) --controller-manager-timeout $(var controller_manager_timeout) $(var activation_args)" />
  </group>
</launch>
