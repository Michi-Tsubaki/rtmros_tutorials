<?xml version="1.0"?>
<launch>
  <arg name="log_level" default="info"/>

  <arg name="right_comport" default="/dev/right_ft_sensor"/>
  <arg name="left_comport" default="/dev/left_ft_sensor"/>
  <arg name="right_namespace" default="right_ft"/>
  <arg name="left_namespace" default="left_ft"/>
  <arg name="right_frame_id" default="right_ft_sensor"/>
  <arg name="left_frame_id" default="left_ft_sensor"/>

  <arg name="camera_namespace" default="camera"/>
  <arg name="camera_name" default="l515"/>
  <arg name="serial_no" default="''"/>
  <arg name="usb_port_id" default="''"/>
  <arg name="initial_reset" default="false"/>
  <arg name="enable_pointcloud" default="true"/>
  <arg name="enable_rgbd" default="false"/>
  <arg name="align_depth" default="true"/>
  <arg name="publish_tf" default="true"/>
  <arg name="tf_prefix" default=""/>

  <include file="$(find-pkg-share nextage_tutorials)/launch/leptrino_force_torque.launch.xml">
    <arg name="right_comport" value="$(var right_comport)"/>
    <arg name="left_comport" value="$(var left_comport)"/>
    <arg name="right_namespace" value="$(var right_namespace)"/>
    <arg name="left_namespace" value="$(var left_namespace)"/>
    <arg name="right_frame_id" value="$(var right_frame_id)"/>
    <arg name="left_frame_id" value="$(var left_frame_id)"/>
  </include>

  <include file="$(find-pkg-share nextage_tutorials)/launch/realsense_l515.launch.xml">
    <arg name="camera_namespace" value="$(var camera_namespace)"/>
    <arg name="camera_name" value="$(var camera_name)"/>
    <arg name="serial_no" value="$(var serial_no)"/>
    <arg name="usb_port_id" value="$(var usb_port_id)"/>
    <arg name="initial_reset" value="$(var initial_reset)"/>
    <arg name="enable_pointcloud" value="$(var enable_pointcloud)"/>
    <arg name="enable_rgbd" value="$(var enable_rgbd)"/>
    <arg name="align_depth" value="$(var align_depth)"/>
    <arg name="publish_tf" value="$(var publish_tf)"/>
    <arg name="tf_prefix" value="$(var tf_prefix)"/>
    <arg name="log_level" value="$(var log_level)"/>
  </include>

  <include file="$(find-pkg-share nextage_tutorials)/launch/nextage_ros1bridge.launch.xml">
    <arg name="log_level" value="$(var log_level)"/>
  </include>
</launch>
